<Window x:Class="WarehouseApp.Windows.Popups.AddMaterialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Új anyag hozzáadása" Height="340" Width="400" MinHeight="340" MinWidth="400" WindowStartupLocation="CenterScreen" FontSize="13">

    <Viewbox Stretch="Uniform" MaxHeight="430" Margin="20">
        <StackPanel Width="300">
            <TextBlock Text="Anyag száma:" Padding="0 0 0 0"/>
            <TextBox x:Name="txtNumber" Height="23" Margin="0 0 0 10"/>

            <TextBlock Text="Leírás:" Padding="0 0 0 0"/>
            <TextBox x:Name="txtDescription" Height="23" Margin="0 0 0 10"/>

            <TextBlock Text="Mértékegység:" Padding="0 0 0 0"/>
            <TextBox x:Name="txtUnit" Height="23" Margin="0 0 0 10"/>

            <TextBlock Text="Ár:" Padding="0 0 0 0"/>
            <TextBox x:Name="txtPrice" Height="23" Margin="0 0 0 10"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Hozzáadás" Click="Add_Click" Width="100" Height="30" Margin="10"/>
                <Button Content="Mégse" Click="Cancel_Click" Width="100" Height="30" Margin="10"/>
            </StackPanel>
        </StackPanel>
    </Viewbox>
    
</Window>
