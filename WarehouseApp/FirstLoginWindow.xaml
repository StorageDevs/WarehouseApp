<Window x:Class="WarehouseApp.Windows.Popups.FirstLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Első bejelentkezés - jelszó csere" Height="285" Width="400" MinHeight="285" MinWidth="400"
        WindowStartupLocation="CenterScreen" FontSize="13">

    <Viewbox Stretch="Uniform" MaxHeight="430" Margin="20">
        <StackPanel Width="300">
            <TextBlock Text="Első bejelentkezéskor új jelszót kell megadnod." FontWeight="Bold" Margin="0,0,0,15" Padding="0" TextWrapping="Wrap" />
            
            <TextBlock Text="Új jelszó:" Padding="0" />
            <PasswordBox x:Name="TxtNewPassword" Height="23" KeyDown="txtPassword_KeyDown" Margin="0 0 0 10"/>

            <TextBlock Text="Jelszó megerősítése:" Padding="0"/>
            <PasswordBox x:Name="TxtConfirmPassword" Height="23" KeyDown="txtPassword_KeyDown" Margin="0 0 0 10"/>

            <Button Content="Mentés" Click="BtnSave_Click" Height="30" Margin="0 10 0 0"/>
        </StackPanel>
    </Viewbox>
</Window>
