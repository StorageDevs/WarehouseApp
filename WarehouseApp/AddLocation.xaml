<Window x:Class="WarehouseApp.Windows.Popups.AddLocationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Új Tárhely hozzáadása" Height="285" Width="400" MinHeight="285" MinWidth="400" WindowStartupLocation="CenterScreen" FontSize="13">

    <Viewbox Stretch="Uniform" MaxHeight="430" Margin="20">
        <StackPanel Width="300" >
            <TextBlock Text="Név:" Padding="0 0 0 0"/>
            <TextBox x:Name="txtName" Height="23" Margin="0 0 0 10"/>

            <TextBlock Text="Leírás:" Padding="0 0 0 0"/>
            <TextBox x:Name="txtDescription" Height="23" Margin="0 0 0 10"/>

            <TextBlock Text="Kapacitás:" Padding="0 0 0 0"/>
            <TextBox x:Name="txtCapacity" Height="23"  Margin="0 0 0 10"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Hozzáadás" Click="Add_Click" Width="100" Height="30" Margin="10"/>
                <Button Content="Mégse" Click="Cancel_Click" Width="100" Height="30" Margin="10"/>
            </StackPanel>
        </StackPanel>
    </Viewbox>

</Window>