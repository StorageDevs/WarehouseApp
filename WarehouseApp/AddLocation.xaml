<Window x:Class="WarehouseApp.Windows.Popups.AddLocationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Új Tárhely hozzáadása" Height="257.093" Width="400" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Név:" Padding="0 0 0 0"/>
            <TextBox x:Name="txtName" Margin="0 0 0 10"/>

            <TextBlock Text="Leírás:" Padding="0 0 0 0"/>
            <TextBox x:Name="txtDescription" Margin="0 0 0 10"/>

            <TextBlock Text="Kapacitás:" Padding="0 0 0 0"/>
            <TextBox x:Name="txtCapacity" Margin="0 0 0 10"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Hozzáadás" Click="Add_Click" Width="100" Margin="10"/>
                <Button Content="Mégse" Click="Cancel_Click" Width="100" Margin="10"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>