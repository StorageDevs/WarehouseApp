<Page x:Class="WarehouseApp.Windows.Pages.UsersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="User Management">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Gombok a felhasználók kezelésére -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="10">
            <Button Content="Hozzáadás" Click="AddUser_Click" Height="40" Width="150" Margin="10" VerticalAlignment="Top" HorizontalAlignment="Left"/>
            <Button Content="Eltávolítás" Click="DeleteUser_Click" Height="40" Width="150" Margin="10" VerticalAlignment="Top" HorizontalAlignment="Left"/>
        </StackPanel>

        <!-- Felhasználók listája -->
        <ListView x:Name="UserList" Grid.Row="1" ItemsSource="{Binding Users}" Margin="10" SelectionMode="Extended">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Username" DisplayMemberBinding="{Binding UserName}" />
                    <GridViewColumn Header="Full Name" DisplayMemberBinding="{Binding FullName}" />
                    <GridViewColumn Header="Email" DisplayMemberBinding="{Binding Email}" />
                    <GridViewColumn Header="Role" DisplayMemberBinding="{Binding DisplayRole}" />
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Page>
