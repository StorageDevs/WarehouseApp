<Window x:Class="WarehouseApp.Windows.Popups.AddUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Új Felhasználó hozzáadása" Height="400" Width="400" MinHeight="400" MinWidth="400" WindowStartupLocation="CenterScreen"  FontSize="13">
    <Viewbox Stretch="Uniform" MaxHeight="530" Margin="20">
        <StackPanel Width="300">
            <TextBlock Text="Felhasználónév:" Padding="0 0 0 0"/>
            <TextBox x:Name="txtUserName" Height="23" Margin="0 0 0 10"/>

            <TextBlock Text="Teljes név:" Padding="0 0 0 0" />
            <TextBox x:Name="txtFullName" Height="23" Margin="0 0 0 10"/>

            <TextBlock Text="Email cím:" Padding="0 0 0 0" />
            <TextBox x:Name="txtEmail" Height="23" Margin="0 0 0 10"/>

            <TextBlock Text="Szerepkör:" Padding="0 0 0 0"/>
            <ComboBox x:Name="cmbRole" Height="23" Margin="0 0 0 10">
                <ComboBoxItem Content="user" IsSelected="True"/>
                <ComboBoxItem Content="superuser"/>
                <ComboBoxItem Content="admin"/>
            </ComboBox>

            <TextBlock Text="Ideiglenes jelszó: TempPassword-123" />
            <TextBlock Text="A felhasználónak meg kell változtatnia első bejelentkezéskor!" TextWrapping="WrapWithOverflow"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Hozzáadás" Click="AddUser_Click" Width="100" Height="30" Margin="10"/>
                <Button Content="Mégse" Click="Cancel_Click" Width="100" Height="30" Margin="10"/>
            </StackPanel>
        </StackPanel>
    </Viewbox>
</Window>
