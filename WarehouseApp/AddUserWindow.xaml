<Window x:Class="WarehouseApp.Windows.Popups.AddUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Új Felhasználó hozzáadása" Height="331.395" Width="400" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Felhasználónév:" />
            <TextBox x:Name="txtUserName" Margin="0 0 0 10"/>

            <TextBlock Text="Teljes név:" />
            <TextBox x:Name="txtFullName" Margin="0 0 0 10"/>

            <TextBlock Text="Email cím:" />
            <TextBox x:Name="txtEmail" Margin="0 0 0 10"/>

            <!-- Szerepkör választó -->
            <TextBlock Text="Szerepkör:" />
            <ComboBox x:Name="cmbRole" Margin="0 0 0 10">
                <ComboBoxItem Content="user" IsSelected="True"/>
                <ComboBoxItem Content="superuser"/>
                <ComboBoxItem Content="admin"/>
            </ComboBox>

            <TextBlock Text="Ideiglenes jelszó: TempPassword-123!" />
            <TextBlock Text="A felhasználónak meg kell változtatnia első bejelentkezéskor!" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Hozzáadás" Click="AddUser_Click" Width="100" Margin="10"/>
                <Button Content="Mégse" Click="Cancel_Click" Width="100" Margin="10"/>
            </StackPanel>
        </StackPanel>

    </Grid>
</Window>
