<Page x:Class="WarehouseApp.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Dashboard">
    <Grid>
        <StackPanel VerticalAlignment="Center" Margin="0 0 0 30">
            <!-- Üdvözlő szöveg -->
            <TextBlock Text="Üdvözöllek az Admin Dashboardon!" HorizontalAlignment="Center" FontSize="24"/>
            <!-- Teljes név -->
            <TextBlock Text="{Binding CurrentFullName}" HorizontalAlignment="Center" FontSize="35" FontWeight="Bold" Foreground="DarkBlue" />
        </StackPanel>
    </Grid>
</Page>
