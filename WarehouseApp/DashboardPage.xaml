<Page x:Class="WarehouseApp.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Dashboard">
    <Grid>
        <StackPanel VerticalAlignment="Center">
            <!-- Üdvözlő szöveg -->
            <TextBlock Text="Üdvözöllek az Admin Dashboardon!" HorizontalAlignment="Center" FontSize="24"/>
            <!-- Felhasználónév -->
            <TextBlock Text="{Binding CurrentUserName}" HorizontalAlignment="Center" FontSize="35" FontWeight="Bold" Foreground="DarkBlue" />
        </StackPanel>
    </Grid>
</Page>
